# API tokens (what each Canopy Music hub sends as Authorization: Bearer)
# aren't set here: the admin makes them on the admin page, /admin, and
# they're kept on the volume (DATA_DIR/tokens.json, hashes only).

# The admin page's sign-in: Canopy Accounts. Locally the account service
# runs on :3000; in production it's https://account.canopysf.com.
CANOPY_ACCOUNT_URL=http://localhost:3000
# The key from the account admin's Sites tab, for a site named "cmdlp".
# Shown once, when it's made. In that site's row, grant the "email" field
# and no other contact field (phone, Instagram, Venmo, Cash App): the
# admin page knows the admin by their email. Leave "Allows quick
# (unverified) accounts" off. Without these two, nobody can sign in to
# /admin; the API still works with the tokens already made.
CANOPY_ACCOUNT_KEY=cnp_xxxxxxxx

# The one admin: the Canopy Account email allowed into /admin (compared
# ignoring case, and only once that email is confirmed). Unset, nobody
# gets in.
# ADMIN_EMAIL=you@example.com

# The domain every Canopy site lives under: the admin page's Origin check
# uses it.
# CANOPY_DOMAIN=canopysf.com

# Where this service is, for the URLs in answers (audioUrl, and the
# SoundCloud fallback artwork). Unset, it's https://cmdlp.<CANOPY_DOMAIN>
# in production, and the address the request came to otherwise.
# PUBLIC_URL=https://cmdlp.canopysf.com

# How long audio is kept, from when its link was resolved, if its zone
# isn't deleted first; and how often the sweep looks.
# MAX_AGE_HOURS=24
# SWEEP_MINUTES=15

# The loudness tracks are brought to, in LUFS (about Apple Music's with
# Sound Check); "off" leaves them as they came.
# LOUDNESS_TARGET=-16

# Downloads at once; the rest wait their turn.
# DOWNLOAD_CONCURRENCY=2

# The image's stable yt-dlp, the last fallback, and the first copy on a
# new volume. Locally, without Docker: the one Homebrew installed, with
# updates off (0), since Homebrew updates it.
# YTDLP_STABLE=/opt/homebrew/bin/yt-dlp
# YTDLP_AUTO_UPDATE=0

# Only if YouTube starts asking to "confirm you're not a bot": a Netscape
# cookies.txt from a signed-in browser (a throwaway Google account, not
# yours). yt-dlp writes it back as it goes, so it must be writable: put it
# on the volume. See README.md > When YouTube blocks it.
# YTDLP_COOKIES=/app/data/cookies.txt

# 3002 locally, so the account service and events can have 3000 and 3001.
# The Dockerfile sets 3000 for Coolify.
PORT=3002
DATA_DIR=./data
