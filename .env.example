# What every request but /health sends as Authorization: Bearer <token>:
# the Canopy Music hubs have it. At least 16 characters; make one with
# openssl rand -base64 32. Changing it also changes every audioUrl (each
# carries a key made from it), so a party in progress loses its queue.
CMDLP_TOKEN=REPLACE_WITH_openssl_rand_-base64_32

# Where this service is, for the audioUrl in answers. Unset, it's the
# address the request came to (behind Coolify's proxy, that's right).
# PUBLIC_URL=https://cmdlp.canopysf.com

# How long audio is kept, from when its link was resolved, if its zone
# isn't deleted first; and how often the sweep looks.
# MAX_AGE_HOURS=24
# SWEEP_MINUTES=15

# Downloads at once; the rest wait their turn.
# DOWNLOAD_CONCURRENCY=2

# The image's stable yt-dlp, the last fallback, and the first copy on a
# new volume. Locally, without Docker: the one Homebrew installed, with
# updates off (0), since Homebrew updates it.
# YTDLP_STABLE=/opt/homebrew/bin/yt-dlp
# YTDLP_AUTO_UPDATE=0

# Only if YouTube starts asking to "confirm you're not a bot": a Netscape
# cookies.txt from a signed-in browser (a throwaway Google account, not
# yours). yt-dlp writes it back as it goes, so it must be writable: put it
# on the volume. See README.md > When YouTube blocks it.
# YTDLP_COOKIES=/app/data/cookies.txt

# 3002 locally, so the account service and events can have 3000 and 3001.
# The Dockerfile sets 3000 for Coolify.
PORT=3002
DATA_DIR=./data
